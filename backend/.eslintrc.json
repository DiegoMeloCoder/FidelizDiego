{
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:prettier/recommended" // Integra Prettier con ESLint
  ],
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "prettier/prettier": "warn", // Muestra warnings de Prettier como errores de ESLint
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }], // Advierte sobre variables no usadas
    "no-console": "off" // Permite console.log en desarrollo (se puede cambiar a "warn" o "error" para producción)
  },
  "ignorePatterns": ["node_modules/", "coverage/", "dist/"]
}
